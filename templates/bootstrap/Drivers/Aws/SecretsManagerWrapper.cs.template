using Gbm.Automation.Core.Aws;
using Gbm.Automation.Core.Aws.Abstractions;
using Newtonsoft.Json;

namespace {{PROJECT_NAME}}.Drivers.Aws;

/// <summary>
/// Wraps AWS Secrets Manager operations with project-specific convenience methods.
/// </summary>
public class SecretsManagerWrapper : IDisposable
{
    private readonly ISecretManagerClient _client;
    private readonly string _region;
    private bool _disposed;

    /// <summary>
    /// Initializes a new instance of the <see cref="SecretsManagerWrapper"/> class.
    /// </summary>
    /// <param name="region">The AWS region to use for secret resolution.</param>
    public SecretsManagerWrapper(string region = "us-east-1")
    {
        _region = region;

        if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("AWS_REGION")))
            Environment.SetEnvironmentVariable("AWS_REGION", region);

        if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("AWS_DEFAULT_REGION")))
            Environment.SetEnvironmentVariable("AWS_DEFAULT_REGION", region);

        _client = new SecretsManagerClient();
        Console.WriteLine($"SecretsManagerWrapper initialized for region: {region}");
    }

    /// <summary>
    /// Retrieves a secret value as raw string.
    /// </summary>
    /// <param name="secretName">The AWS secret name.</param>
    /// <returns>The raw secret string when found; otherwise <see langword="null"/>.</returns>
    public async Task<string?> GetSecretStringAsync(string secretName)
    {
        try
        {
            Console.WriteLine($"Retrieving secret: {secretName}");
            var secret = await _client.GetSecretValueAsync(secretName);
            Console.WriteLine($"Secret retrieved: {secretName}");
            return secret;
        }
        catch (Amazon.SecretsManager.AmazonSecretsManagerException ex) when (ex.ErrorCode == "ExpiredToken")
        {
            throw new InvalidOperationException(
                $"AWS SSO token expired. Run: aws sso login --profile {Environment.GetEnvironmentVariable("AWS_PROFILE")}", ex);
        }
        catch (Amazon.SecretsManager.AmazonSecretsManagerException ex) when (ex.ErrorCode == "ResourceNotFoundException")
        {
            throw new InvalidOperationException($"Secret '{secretName}' not found in AWS Secrets Manager.", ex);
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException($"Failed to retrieve secret '{secretName}'.", ex);
        }
    }

    /// <summary>
    /// Retrieves and deserializes a secret payload into a typed object.
    /// </summary>
    /// <typeparam name="T">The destination type for deserialization.</typeparam>
    /// <param name="secretName">The AWS secret name.</param>
    /// <returns>The deserialized object, or <see langword="null"/> when payload is empty.</returns>
    public async Task<T?> GetSecretAsAsync<T>(string secretName) where T : class
    {
        var secretString = await GetSecretStringAsync(secretName);

        if (string.IsNullOrWhiteSpace(secretString))
            return null;

        try
        {
            return JsonConvert.DeserializeObject<T>(secretString);
        }
        catch (JsonException ex)
        {
            throw new InvalidOperationException(
                $"Secret '{secretName}' could not be deserialized to {typeof(T).Name}.", ex);
        }
    }

    /// <summary>
    /// Retrieves a SQL Server connection string from a structured database secret.
    /// </summary>
    /// <param name="secretName">The AWS secret name.</param>
    /// <returns>The generated connection string, or <see langword="null"/> when data is not available.</returns>
    public async Task<string?> GetDatabaseConnectionStringAsync(string secretName)
    {
        var dbSecret = await GetSecretAsAsync<DatabaseSecretModel>(secretName);
        return dbSecret?.ToConnectionString();
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        if (_disposed) return;
        (_client as IDisposable)?.Dispose();
        _disposed = true;
        GC.SuppressFinalize(this);
    }
}

/// <summary>
/// Represents the expected shape of a database secret payload.
/// </summary>
public class DatabaseSecretModel
{
    /// <summary>Gets or sets the database server host.</summary>
    [JsonProperty("server")]
    public string Server { get; set; } = string.Empty;

    /// <summary>Gets or sets the optional database server port.</summary>
    [JsonProperty("port")]
    public string? Port { get; set; }

    /// <summary>Gets or sets the database user identifier.</summary>
    [JsonProperty("user_id")]
    public string UserId { get; set; } = string.Empty;

    /// <summary>Gets or sets the database user password.</summary>
    [JsonProperty("password")]
    public string Password { get; set; } = string.Empty;

    /// <summary>Gets or sets the database name.</summary>
    [JsonProperty("database")]
    public string Database { get; set; } = string.Empty;

    /// <summary>
    /// Validates required fields for connection string construction.
    /// </summary>
    /// <returns><see langword="true"/> when required fields are present; otherwise, <see langword="false"/>.</returns>
    public bool IsValid() =>
        !string.IsNullOrWhiteSpace(Server) &&
        !string.IsNullOrWhiteSpace(UserId) &&
        !string.IsNullOrWhiteSpace(Password) &&
        !string.IsNullOrWhiteSpace(Database);

    /// <summary>
    /// Builds a SQL Server connection string from the secret payload.
    /// </summary>
    /// <returns>The SQL Server connection string.</returns>
    public string ToConnectionString()
    {
        if (!IsValid())
            throw new InvalidOperationException("Database secret is missing required fields: Server, UserId, Password, or Database.");

        var serverAddress = string.IsNullOrWhiteSpace(Port) ? Server : $"{Server},{Port}";
        return $"Server={serverAddress};Database={Database};User Id={UserId};Password={Password};TrustServerCertificate=True;Encrypt=True;";
    }
}
