using Gbm.Automation.Core.Aws;
using Gbm.Automation.Core.Aws.Abstractions;
using Gbm.Automation.Core.Utils.Common;

namespace {{PROJECT_NAME}}.Drivers;

/// <summary>
/// Resolves database connection settings from AWS Secrets Manager or local configuration.
/// </summary>
public class AwsSecretsManagerDriver
{
    private readonly ConfigurationDriver _configuration;
    private readonly Func<ISecretManagerClient> _secretManagerClientFactory;

    /// <summary>
    /// Initializes a new instance of the <see cref="AwsSecretsManagerDriver"/> class.
    /// </summary>
    /// <param name="configuration">Runtime configuration accessor.</param>
    public AwsSecretsManagerDriver(ConfigurationDriver configuration)
        : this(configuration, () => new SecretsManagerClient())
    {
    }

    /// <summary>
    /// Initializes a new instance of the <see cref="AwsSecretsManagerDriver"/> class.
    /// </summary>
    /// <param name="configuration">Runtime configuration accessor.</param>
    /// <param name="secretManagerClientFactory">Factory that builds a secrets manager client.</param>
    public AwsSecretsManagerDriver(
        ConfigurationDriver configuration,
        Func<ISecretManagerClient> secretManagerClientFactory)
    {
        _configuration = configuration;
        _secretManagerClientFactory = secretManagerClientFactory;
    }

    /// <summary>
    /// Resolves the database connection string from AWS secret payload or fallback configuration.
    /// </summary>
    /// <returns>The resolved connection string, or empty when only placeholder values are configured.</returns>
    public async Task<string> ResolveDatabaseConnectionStringAsync()
    {
        if (!string.IsNullOrWhiteSpace(_configuration.DatabaseConnectionSecretName))
        {
            var secretPayload = await GetSecretAsync(_configuration.DatabaseConnectionSecretName);
            if (!string.IsNullOrWhiteSpace(secretPayload))
            {
                var secretSettings = JsonUtil.DeserializeObject<DataConnectionSettings>(secretPayload)
                    ?? throw new InvalidOperationException("AWS secret for database connection could not be deserialized.");

                return BuildSqlServerConnectionString(secretSettings);
            }
        }

        return IsPlaceholderConnectionString(_configuration.DatabaseConnectionString)
            ? string.Empty
            : _configuration.DatabaseConnectionString;
    }

    /// <summary>
    /// Retrieves a raw secret payload by name.
    /// </summary>
    /// <param name="secretName">The AWS secret name.</param>
    /// <returns>The raw secret payload when available; otherwise <see langword="null"/>.</returns>
    public async Task<string?> GetSecretAsync(string secretName)
    {
        ISecretManagerClient? client = null;
        try
        {
            EnsureAwsRegionEnvironment();
            client = _secretManagerClientFactory();
            return await client.GetSecretValueAsync(secretName);
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException($"Failed to retrieve AWS secret '{secretName}'.", ex);
        }
        finally
        {
            (client as IDisposable)?.Dispose();
        }
    }

    private void EnsureAwsRegionEnvironment()
    {
        if (string.IsNullOrWhiteSpace(_configuration.AwsRegion))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("AWS_REGION")))
        {
            Environment.SetEnvironmentVariable("AWS_REGION", _configuration.AwsRegion);
        }

        if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("AWS_DEFAULT_REGION")))
        {
            Environment.SetEnvironmentVariable("AWS_DEFAULT_REGION", _configuration.AwsRegion);
        }
    }

    private static string BuildSqlServerConnectionString(DataConnectionSettings settings)
    {
        if (string.IsNullOrWhiteSpace(settings.Server)
            || string.IsNullOrWhiteSpace(settings.UserId)
            || string.IsNullOrWhiteSpace(settings.Password)
            || string.IsNullOrWhiteSpace(settings.Database))
        {
            throw new InvalidOperationException("AWS database secret is missing one or more required fields: Server, UserId, Password, Database.");
        }

        var server = string.IsNullOrWhiteSpace(settings.Port)
            ? settings.Server
            : $"{settings.Server},{settings.Port}";

        return $"Server={server};Database={settings.Database};User Id={settings.UserId};Password={settings.Password};TrustServerCertificate=True;";
    }

    private static bool IsPlaceholderConnectionString(string connectionString)
    {
        return string.IsNullOrWhiteSpace(connectionString)
            || connectionString.Contains("REPLACE_ME", StringComparison.OrdinalIgnoreCase);
    }
}