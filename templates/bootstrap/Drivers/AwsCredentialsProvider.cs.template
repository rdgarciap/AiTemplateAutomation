using Amazon.Runtime;
using Amazon.Runtime.CredentialManagement;
using Amazon.SecurityToken;
using Amazon.SecurityToken.Model;

namespace {{PROJECT_NAME}}.Drivers;

/// <summary>
/// Resolves and caches AWS credentials for test execution.
/// </summary>
public class AwsCredentialsProvider
{
    private static AWSCredentials? _cachedCredentials;
    private static DateTime _credentialsExpiration = DateTime.MinValue;
    private static readonly object _lock = new object();

    /// <summary>
    /// Gets AWS credentials from the configured profile or fallback provider.
    /// </summary>
    /// <returns>The resolved AWS credentials.</returns>
    public static AWSCredentials GetCredentials()
    {
        lock (_lock)
        {
            if (_cachedCredentials != null && DateTime.UtcNow < _credentialsExpiration.AddMinutes(-5))
            {
                Console.WriteLine("Using cached AWS credentials");
                return _cachedCredentials;
            }

            Console.WriteLine("Resolving AWS credentials...");

            var profileName = Environment.GetEnvironmentVariable("AWS_PROFILE");
            if (!string.IsNullOrEmpty(profileName))
            {
                Console.WriteLine($"Attempting to load profile: {profileName}");
                var chain = new CredentialProfileStoreChain();
                if (chain.TryGetAWSCredentials(profileName, out var credentials))
                {
                    try
                    {
                        credentials.GetCredentials();
                        Console.WriteLine($"Successfully loaded credentials from profile: {profileName}");
                        _cachedCredentials = credentials;
                        _credentialsExpiration = DateTime.UtcNow.AddHours(1);
                        return credentials;
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Profile credentials failed: {ex.Message}");
                    }
                }
            }

            Console.WriteLine("Using FallbackCredentialsFactory");
            var fallbackCredentials = FallbackCredentialsFactory.GetCredentials();
            _cachedCredentials = fallbackCredentials;
            _credentialsExpiration = DateTime.UtcNow.AddHours(1);
            return fallbackCredentials;
        }
    }

    /// <summary>
    /// Clears the in-memory credential cache.
    /// </summary>
    public static void ClearCache()
    {
        lock (_lock)
        {
            _cachedCredentials = null;
            _credentialsExpiration = DateTime.MinValue;
            Console.WriteLine("AWS credentials cache cleared");
        }
    }

    /// <summary>
    /// Validates that the resolved credentials can call STS.
    /// </summary>
    /// <returns><see langword="true"/> when credentials are valid; otherwise, <see langword="false"/>.</returns>
    public static async Task<bool> ValidateCredentialsAsync()
    {
        try
        {
            var credentials = GetCredentials();
            using var stsClient = new AmazonSecurityTokenServiceClient(credentials);
            var response = await stsClient.GetCallerIdentityAsync(new GetCallerIdentityRequest());
            Console.WriteLine($"Credentials validated. Account: {response.Account} | UserId: {response.UserId}");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Credential validation failed: {ex.Message}");
            return false;
        }
    }
}
