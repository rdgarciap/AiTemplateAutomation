using {{PROJECT_NAME}}.Drivers;
using Microsoft.SemanticKernel;
using Reqnroll;
using Reqnroll.BoDi;

namespace {{PROJECT_NAME}}.Hooks;

/// <summary>
/// Configures per-scenario dependencies and plugin registration.
/// </summary>
[Binding]
public class TestLifecycleHooks
{
    private readonly IObjectContainer _container;

    /// <summary>
    /// Initializes a new instance of the <see cref="TestLifecycleHooks"/> class.
    /// </summary>
    /// <param name="container">The Reqnroll DI container for the active scenario.</param>
    public TestLifecycleHooks(IObjectContainer container)
    {
        _container = container;
    }

    /// <summary>
    /// Builds and registers all scenario services before each test scenario.
    /// </summary>
    [BeforeScenario]
    public void SetupScenario()
    {
        var config = new ConfigurationDriver();
        var aiContext = new AiContext();

        _container.RegisterInstanceAs(config);
        _container.RegisterInstanceAs(aiContext);

        var kernel = KernelFactory.Build(config);
        _container.RegisterInstanceAs(kernel);

        SkillRegistry.RegisterCoreSkills(kernel, aiContext, _container);
    }

    /// <summary>
    /// Executes scenario teardown tasks.
    /// </summary>
    [AfterScenario]
    public void TeardownScenario()
    {
        // Release UI drivers, open connections, or other external resources here.
    }
}