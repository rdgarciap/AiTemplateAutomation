<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════
  NuGet.Config — Feed privado GBM (GitHub Packages)
  ════════════════════════════════════════════════════════════════════════
  La contraseña se lee directamente de la variable de entorno
  VSTS_GITHUB_ACCESS_KEY. NuGet resuelve %VAR% sin pasos intermedios.

  En el pipeline (AWS CodeBuild), exponer el token así:
    env:
      parameter-store:
        VSTS_GITHUB_ACCESS_KEY: devops.github.token.read

  No se necesita sed ni sustitución manual en pre_build.
  ════════════════════════════════════════════════════════════════════════
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="gbmWallE"  value="https://nuget.pkg.github.com/gbmcode/index.json" />
  </packageSources>

  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>

  <disabledPackageSources>
    <add key="Microsoft and .NET" value="true" />
  </disabledPackageSources>

  <packageSourceCredentials>
    <gbmWallE>
      <add key="Username"          value="gbm" />
      <add key="ClearTextPassword" value="%VSTS_GITHUB_ACCESS_KEY%" />
    </gbmWallE>
  </packageSourceCredentials>
</configuration>